# Single-Server Deployment Environment Configuration for UCust.AI

# Database Settings
POSTGRES_DB=ai_smm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
UCUST_DB_HOST=db
UCUST_DB_PORT=5432

# Application Settings
UCUST_LOG_LEVEL=INFO
UCUST_APP_TITLE="UCust.AI API"
UCUST_APP_VERSION="2.1.0-SingleServer"

# ComfyUI Integration (Single-Server)
COMFYUI_SERVER_ADDRESS=host.docker.internal:8188
COMFYUI_OUTPUT_DIR=/app/output
HOST_COMFYUI_OUTPUT_DIR=/path/to/ComfyUI/output

# Travity Web Search API Key
TRAVITY_API_KEY=tvly-your-api-key-here

# Octopoda local server. These values avoid cloud authentication in development.
OCTOPODA_API_KEY=local-dev
OCTOPODA_BASE_URL=http://localhost:8741
OCTOPODA_AGENT_ID=my-assistant
# Used by integration.octopoda_dashboard (visual local dashboard).
OCTOPODA_DASHBOARD_API_URL=http://127.0.0.1:8741
