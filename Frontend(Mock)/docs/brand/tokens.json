{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "UCust",
    "version": "1.0",
    "updated": "2026-07-02",
    "source": "docs/brand/UCust-brandbook.html"
  },
  "color": {
    "brand": {
      "default": { "value": "#4F7DFF", "description": "Основной фирменный синий" },
      "hover":   { "value": "#3D63E6" },
      "tint":    { "value": "#E6ECFF", "description": "Светлая подложка/заливка" },
      "poster":  { "value": "#1A5BFF", "description": "Насыщенный акцент для плакатных блоков" }
    },
    "accent": {
      "purple": { "value": "#7B5CFF" },
      "pink":   { "value": "#FF5FA2" },
      "orange": { "value": "#FF8C4B" }
    },
    "gradient": {
      "brand": {
        "value": "linear-gradient(120deg, #4F7DFF 0%, #7B5CFF 38%, #FF5FA2 72%, #FF8C4B 100%)",
        "stops": ["#4F7DFF", "#7B5CFF", "#FF5FA2", "#FF8C4B"],
        "angle": "120deg"
      }
    },
    "status": {
      "success": { "value": "#18A957", "tint": "#E3F5EB" },
      "warning": { "value": "#F5A623", "tint": "#FEF4E1" },
      "error":   { "value": "#E5484D", "tint": "#FCEBEC" },
      "info":    { "value": "#2D9CDB", "tint": "#E4F1FB" }
    },
    "chart": [
      "#4F7DFF", "#7B5CFF", "#FF5FA2", "#FF8C4B", "#12B5A5", "#F5C147"
    ],
    "neutral": {
      "50":  { "value": "#F8F9FC", "alias": "surface-soft" },
      "100": { "value": "#F2F4F7", "alias": "canvas" },
      "200": { "value": "#E6E9F0", "alias": "border" },
      "300": { "value": "#D4D9E3" },
      "400": { "value": "#B0B7C6" },
      "500": { "value": "#6B7280", "alias": "ink-muted" },
      "600": { "value": "#4B5163" },
      "700": { "value": "#363B4A" },
      "800": { "value": "#272D3B", "alias": "dark-border" },
      "900": { "value": "#1F2433", "alias": "ink" }
    },
    "role": {
      "canvas":      { "value": "#F2F4F7" },
      "card":        { "value": "#FFFFFF" },
      "border":      { "value": "#E6E9F0" },
      "ink":         { "value": "#1F2433" },
      "ink-muted":   { "value": "#6B7280" }
    }
  },
  "typography": {
    "fontFamily": {
      "brand": "Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "scale": {
      "display": { "size": "44-76px", "weight": 800, "tracking": "-0.03em" },
      "h1":      { "size": "34px", "weight": 800, "tracking": "-0.02em" },
      "h2":      { "size": "26px", "weight": 700 },
      "lead":    { "size": "19px", "weight": 500 },
      "body":    { "size": "16px", "weight": 400, "lineHeight": 1.5 },
      "kicker":  { "size": "13px", "weight": 600, "case": "uppercase", "tracking": "0.14em" },
      "caption": { "size": "13px", "weight": 400 }
    }
  },
  "radius": {
    "card": "32px",
    "card-sm": "18px"
  }
}
