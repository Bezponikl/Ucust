# Копировать в .env.local

# Адрес API бэка. Фронт работает только с настоящими данными, поэтому переменная
# нужна в любом окружении: без неё запросы уйдут на текущий origin и упрутся в 404.
#
#   /api/v0                                 — фронт и API за одним nginx (стек целиком)
#   http://localhost:8100/api/v0            — фронт локально, шлюз рядом
#   https://api.ucust.n4d3sh1k4.site/api/v0 — тестовый контур на сервере
NEXT_PUBLIC_API_BASE_URL=/api/v0
