{
  "api": {
    "version": "v0",
    "basePath": "/api/v0",
    "gatewayUriLocal": "http://localhost:8100",
    "gatewayUriProd": "https://api.ucust.n4d3sh1k4.site",
    "auth": {
      "type": "Bearer",
      "accessTokenHeader": "Authorization: Bearer <accessToken>",
      "refreshTokenCookie": "refreshToken",
      "note": "Access token приходит в body, refresh token — в куке. При каждом ответе логина/refresh кука перезаписывается.",
      "publicRoutes": [
        "/api/v0/auth/login",
        "/api/v0/auth/register",
        "/api/v0/auth/refresh",
        "/api/v0/auth/forgot-password",
        "/api/v0/auth/reset-password",
        "/api/v0/auth/confirm-email",
        "/api/v0/auth/resend-confirmation",
        "/oauth2/**",
        "/login/oauth2/**",
        "/api/v0/tariffs",
        "/api/v0/tariffs/{id}"
      ]
    },
    "services": [
      {
        "name": "security-service",
        "controllers": {
          "AuthController": {
            "tag": "Авторизация",
            "basePath": "/auth",
            "endpoints": [
              {
                "method": "POST",
                "path": "/api/v0/auth/register",
                "summary": "Регистрация пользователей",
                "auth": "public",
                "requestBody": {
                  "firstName": { "type": "string", "required": true, "description": "Имя" },
                  "lastName": { "type": "string", "required": true, "description": "Фамилия" },
                  "email": { "type": "string", "required": true, "description": "Почта" },
                  "password": { "type": "string", "required": true, "description": "Пароль" },
                  "confirmPassword": { "type": "string", "required": true, "description": "Повтор пароля" }
                },
                "response": "200 OK",
                "cookies": ["refreshToken"]
              },
              {
                "method": "GET",
                "path": "/api/v0/auth/confirm-email",
                "summary": "Подтверждение почты (переход по ссылке из письма)",
                "auth": "public",
                "queryParams": {
                  "token": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/resend-confirmation",
                "summary": "Повторная отправка письма активации",
                "auth": "public",
                "queryParams": {
                  "email": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/login",
                "summary": "Авторизация пользователей",
                "auth": "public",
                "requestBody": {
                  "email": { "type": "string", "required": true },
                  "password": { "type": "string", "required": true }
                },
                "response": "JwtResponse { accessToken: string }",
                "cookies": ["refreshToken (httpOnly)"]
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/refresh",
                "summary": "Обновление refresh токена",
                "auth": "public",
                "cookies": ["refreshToken", "required"],
                "response": "JwtResponse { accessToken: string } + новая кука"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/logout",
                "summary": "Выход из аккаунта",
                "auth": "Bearer",
                "cookies": ["refreshToken (необязательно)"],
                "response": "200 OK 'Logged out successfully' + кука на удаление"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/forgot-password",
                "summary": "Смена/восстановление пароля. Шаг 1: отправить письмо",
                "auth": "public",
                "requestBody": {
                  "email": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/reset-password",
                "summary": "Смена/восстановление пароля. Шаг 2: установить новый",
                "auth": "public",
                "requestBody": {
                  "token": { "type": "string", "required": true, "description": "Токен из письма" },
                  "newPassword": { "type": "string", "required": true },
                  "confirmPassword": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/yandex-mobile",
                "summary": "Авторизация через Яндекс (мобильный токен)",
                "auth": "public",
                "requestBody": {
                  "accessToken": { "type": "string", "required": true, "description": "Access token от Яндекс OAuth" }
                },
                "response": "JwtResponse { accessToken: string } + кука"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/link-social",
                "summary": "Привязка соцсети к аккаунту (после ввода пароля)",
                "auth": "public",
                "requestBody": {
                  "email": { "type": "string", "required": true },
                  "password": { "type": "string", "required": true },
                  "provider": { "type": "AuthProvider enum", "required": true, "values": "GOOGLE|YANDEX|..." },
                  "providerUserId": { "type": "string", "required": true }
                },
                "response": "JwtResponse { accessToken: string } + кука"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/change-email/verify-password",
                "summary": "Смена почты. Шаг 1: подтвердить пароль",
                "auth": "Bearer",
                "requestBody": {
                  "password": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/change-email/set-new-email",
                "summary": "Смена почты. Шаг 2: отправить код на новую почту",
                "auth": "public",
                "requestBody": {
                  "token": { "type": "string", "required": true },
                  "newEmail": { "type": "string", "required": true }
                },
                "response": "200 OK"
              },
              {
                "method": "POST",
                "path": "/api/v0/auth/change-email/confirm",
                "summary": "Смена почты. Шаг 3: подтвердить смену",
                "auth": "public",
                "requestBody": {
                  "token": { "type": "string", "required": true },
                  "code": { "type": "string", "required": true }
                },
                "response": "200 OK"
              }
            ]
          },
          "StatusController": {
            "tag": "Статус",
            "basePath": "/status",
            "endpoints": [
              {
                "method": "GET",
                "path": "/api/v0/status/hello",
                "summary": "Проверка работоспособности",
                "auth": "Bearer",
                "response": "200 OK 'hello'"
              },
              {
                "method": "GET",
                "path": "/api/v0/status/me",
                "summary": "Данные текущего пользователя из заголовков Gateway",
                "auth": "Bearer",
                "response": "{ userId: string, roles: string[], source: string }"
              }
            ]
          },
        }
      },
      {
        "name": "user-service",
        "controllers": {
          "ProfileController": {
            "tag": "Профиль",
            "basePath": "/user",
            "gatewayPattern": "/api/v0/user/**",
            "endpoints": [
              {
                "method": "GET",
                "path": "/api/v0/user/me",
                "summary": "Получить профиль текущего пользователя",
                "auth": "Bearer",
                "response": "ProfileResponse (полная информация о профиле)"
              },
              {
                "method": "PATCH",
                "path": "/api/v0/user/me",
                "summary": "Обновить профиль (имя, фамилия, телефон, должность)",
                "auth": "Bearer",
                "requestBody": {
                  "firstName": { "type": "string", "required": false, "constraints": "кириллица, дефис; 2-50" },
                  "lastName": { "type": "string", "required": false, "constraints": "кириллица, дефис; 2-50" },
                  "phone": { "type": "string", "required": false, "constraints": "11 цифр, начинается с 79" },
                  "position": { "type": "string", "required": false, "constraints": "2-50" }
                },
                "response": "ProfileResponse"
              },
              {
                "method": "POST",
                "path": "/api/v0/user/me/avatar",
                "summary": "Загрузить аватар",
                "auth": "Bearer",
                "contentType": "multipart/form-data",
                "formParams": { "file": "JPEG/PNG изображение" },
                "response": "ApiResponse<String> { success, data: avatarUrl }"
              }
            ]
          }
        }
      },
      {
        "name": "business-service",
        "controllers": {
          "ProjectController": {
            "tag": "Проекты",
            "basePath": "/projects",
            "gatewayPattern": "/api/v0/projects/**",
            "endpoints": [
              {
                "method": "POST",
                "path": "/api/v0/projects",
                "summary": "Создать проект",
                "auth": "Bearer",
                "requestBody": {
                  "name": { "type": "string", "required": true, "constraints": "2-100" },
                  "industry": { "type": "Industry enum", "required": true },
                  "city": { "type": "string", "required": true, "constraints": "max 50" },
                  "description": { "type": "string", "required": false, "constraints": "max 2000" },
                  "targetAudience": { "type": "string", "required": false, "constraints": "max 500" },
                  "toneOfVoice": { "type": "ToneOfVoice enum", "required": true },
                  "socialLinks": {
                    "type": "object",
                    "required": false,
                    "fields": {
                      "instagram": { "type": "string", "pattern": "^https://.*" },
                      "telegram": { "type": "string" },
                      "website": { "type": "string" }
                    }
                  },
                  "businessHours": { "type": "object", "required": false, "fields": "BusinessHoursRequest" }
                },
                "response": "ProjectResponse"
              },
              {
                "method": "GET",
                "path": "/api/v0/projects/{id}",
                "summary": "Получить проект по ID",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "response": "ProjectResponse"
              },
              {
                "method": "GET",
                "path": "/api/v0/projects",
                "summary": "Получить свои проекты",
                "auth": "Bearer",
                "response": "ProjectResponse[]"
              },
              {
                "method": "PATCH",
                "path": "/api/v0/projects/{id}",
                "summary": "Частично обновить проект",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "requestBody": {
                  "name": { "type": "string", "required": false, "constraints": "2-100" },
                  "industry": { "type": "Industry enum", "required": false },
                  "city": { "type": "string", "required": false, "constraints": "max 50" },
                  "description": { "type": "string", "required": false, "constraints": "max 2000" },
                  "targetAudience": { "type": "string", "required": false, "constraints": "max 500" },
                  "toneOfVoice": { "type": "ToneOfVoice enum", "required": false },
                  "socialLinks": { "type": "object", "required": false },
                  "businessHours": { "type": "object", "required": false }
                },
                "response": "ProjectResponse"
              },
              {
                "method": "POST",
                "path": "/api/v0/projects/{id}/logo",
                "summary": "Загрузить логотип проекта",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "contentType": "multipart/form-data",
                "formParams": { "file": "JPEG/PNG изображение" },
                "response": "string (url логотипа)"
              },
              {
                "method": "DELETE",
                "path": "/api/v0/projects/{id}",
                "summary": "Удалить проект",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "response": "200 OK"
              }
            ]
          }
        }
      },
      {
        "name": "billing-service",
        "controllers": {
          "TariffController": {
            "tag": "Тарифы",
            "basePath": "/tariffs",
            "gatewayPattern": "/api/v0/tariffs, /api/v0/tariffs/** (public)",
            "endpoints": [
              {
                "method": "GET",
                "path": "/api/v0/tariffs",
                "summary": "Все тарифы",
                "auth": "public",
                "response": "TariffResponse[]"
              },
              {
                "method": "GET",
                "path": "/api/v0/tariffs/{id}",
                "summary": "Тариф по ID",
                "auth": "public",
                "pathParams": { "id": "UUID" },
                "response": "TariffResponse"
              },
            ]
          },
          "UserQuotaController": {
            "tag": "Квоты пользователя",
            "basePath": "/quota",
            "gatewayPattern": "/api/v0/quota/me, /api/v0/quota/me/**",
            "endpoints": [
              {
                "method": "GET",
                "path": "/api/v0/quota/me",
                "summary": "Получить свою квоту по фиче",
                "auth": "Bearer",
                "queryParams": { "feature": { "type": "string", "default": "generation", "required": false } },
                "response": "CheckQuotaResponse"
              },
              {
                "method": "GET",
                "path": "/api/v0/quota/me/tariff",
                "summary": "Свой тариф и квоты по всем фичам",
                "auth": "Bearer",
                "response": "SubscriptionOverview | 404"
              },
              {
                "method": "POST",
                "path": "/api/v0/quota/me/purchase",
                "summary": "Купить тариф (заглушка)",
                "auth": "Bearer",
                "requestBody": {
                  "tariffId": { "type": "UUID", "required": true }
                },
                "response": "SubscriptionOverview"
              }
            ]
          },
        }
      },
      {
        "name": "generative-orchestration-service",
        "controllers": {
          "AsyncGenerationController": {
            "tag": "Асинхронная генерация контента",
            "basePath": "/orchestration",
            "gatewayPattern": "/api/v0/orchestration/**",
            "endpoints": [
              {
                "method": "POST",
                "path": "/api/v0/orchestration/generate/async",
                "summary": "Отправить задачу на генерацию в AI-сервис",
                "auth": "Bearer",
                "requestBody": {
                  "projectId": { "type": "UUID", "required": true },
                  "count": { "type": "int", "required": false, "default": 1 },
                  "mode": { "type": "GenerationMode enum", "required": true },
                  "prompt": { "type": "string", "required": false },
                  "industry": { "type": "string", "required": false },
                  "description": { "type": "string", "required": false },
                  "targetAudience": { "type": "string", "required": false },
                  "toneOfVoice": { "type": "string", "required": false },
                  "city": { "type": "string", "required": false },
                  "currentMonth": { "type": "string", "required": false },
                  "currentYear": { "type": "int", "required": false }
                },
                "response": "202 Accepted AsyncGenerateResponse { taskId }"
              },
              {
                "method": "GET",
                "path": "/api/v0/orchestration/tasks/{taskId}",
                "summary": "Проверить статус выполнения задачи",
                "auth": "Bearer",
                "pathParams": { "taskId": "UUID" },
                "response": "TaskStatusResponse"
              }
            ]
          },
          "GenerationController": {
            "tag": "Генерация контента",
            "basePath": "/orchestration",
            "gatewayPattern": "/api/v0/orchestration/**",
            "endpoints": [
              {
                "method": "POST",
                "path": "/api/v0/orchestration/posts/{id}/confirm",
                "summary": "Подтвердить пост",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "response": "PostResponse"
              },
              {
                "method": "POST",
                "path": "/api/v0/orchestration/posts/{id}/publish",
                "summary": "Опубликовать пост",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "response": "PostResponse"
              },
              {
                "method": "GET",
                "path": "/api/v0/orchestration/posts/{id}",
                "summary": "Получить пост по ID",
                "auth": "Bearer",
                "pathParams": { "id": "UUID" },
                "response": "PostResponse"
              },
              {
                "method": "GET",
                "path": "/api/v0/orchestration/projects/{projectId}/posts",
                "summary": "Посты проекта",
                "auth": "Bearer",
                "pathParams": { "projectId": "UUID" },
                "response": "PostResponse[]"
              }
            ]
          }
        }
      }
    ]
  }
}