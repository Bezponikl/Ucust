FROM python:3.11-slim

WORKDIR /app

COPY ai_mock/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY ai_mock /app/ai_mock
COPY start_mock.py /app/start_mock.py

EXPOSE 8000

ENV AI_MOCK_HOST=0.0.0.0
ENV AI_MOCK_PORT=8000
ENV INTERNAL_API_SECRET=ucust-super-secret-service-token-2026

CMD ["python", "start_mock.py"]
