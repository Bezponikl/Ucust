# ====================================================================
# UCust.AI Multi-Server Environment Configuration (Example)
# СЕРВЕР 2 (AI GPU NODE) -> СЕРВЕР 1 (JAVA BACKEND CORE)
# ====================================================================

# 1. СВЯЗЬ С СЕРВЕРОМ 1 (JAVA BACKEND HTTP PUSH-КОЛЛБЕК)
JAVA_BACKEND_CALLBACK_URL=http://10.0.0.1:8080/api/v1/ai/callback
INTERNAL_API_SECRET=ucust-super-secret-service-token-2026
TOKEN_VAULT_SECRET=ucust-enterprise-production-vault-key-2026

# 2. FASTAPI NATIVE QUEUE MANAGER (GPU ОЧЕРЕДЬ И RETRY)
AI_QUEUE_MAX_CONCURRENCY=1
AI_QUEUE_RETRY_COUNT=3
AI_QUEUE_RETRY_DELAYS=3,10,30

# 3. REDIS ДЛЯ КЭШИРОВАНИЯ И СОХРАНЕНИЯ СОСТОЯНИЙ ОЧЕРЕДИ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 4. ЛОКАЛЬНАЯ БАЗА ДАННЫХ И ВЕКТОРНЫЙ CLEAN RAG (СЕРВЕР 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_smm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 5. УПРАВЛЕНИЕ МЕДИА-КЭШЕМ
MEDIA_RETENTION_DAYS=30
TEMP_CACHE_RETENTION_HOURS=5
MEDIA_AUTO_ARCHIVE=true

# 6. НАСТРОЙКИ AI-СЕРВИСА (GPU И COMFYUI)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
UCUST_LOG_LEVEL=INFO
SERVER_MODE=true
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_SERVER_ADDRESS=127.0.0.1:8188

# 7. КЛЮЧИ И СОЦСЕТИ
TRAVITY_API_KEY=
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=ucust_session
TELEGRAM_BOT_TOKEN=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
