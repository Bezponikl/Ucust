# =====================================================================
# UCust AI & Data Service Configuration (.env)
# =====================================================================

# 1. СЕТЕВЫЕ НАСТРОЙКИ AI ШЛЮЗА (FastAPI)
# ---------------------------------------------------------------------
# 0.0.0.0 позволяет принимать запросы с других серверов и Docker-контейнеров
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# 2. ПОДКЛЮЧЕНИЕ К COMFYUI ДЛЯ ГЕНЕРАЦИИ И РЕДАКТИРОВАНИЯ ФОТО
# ---------------------------------------------------------------------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_URL=http://127.0.0.1:8188

# 3. БАЗЫ ДАННЫХ И ХРАНИЛИЩЕ
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./ai_smm_dev.db
# Для PostgreSQL: postgresql://ucust_user:password@localhost:5432/ucust_db
REDIS_URL=redis://localhost:6379/0

# 4. СОЦИАЛЬНЫЕ СЕТИ И ПУБЛИКАЦИИ UCUST
# ---------------------------------------------------------------------
UCUST_TELEGRAM_LINK=https://t.me/UcustAi
UCUST_MAX_LINK=https://max.ru/channel_UCust
UCUST_VK_LINK=https://vk.ru/ucustai

# Токены для авто-публикаций (при необходимости)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHANNEL=@UcustAi
MAX_API_TOKEN=
MAX_CHAT_ID=channel_UCust
UCUST_VK_ACCESS_TOKEN=
UCUST_VK_GROUP_ID=ucustai
