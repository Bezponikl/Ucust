# ==============================================================================
# UCust AI Production & Development Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVICE GATEWAY
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
APP_NAME=UCust_AI_Gateway
APP_VERSION=2.5.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEV_SIMULATION_MODE=true               # true for Dev/CPU testbench; false for Prod GPU (A100/H100)

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Bearer Token validation secret for multi-tenant isolation
JWT_SECRET=ucust-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256

# Internal service-to-service secret (WireGuard/VPC backend header: X-Internal-Secret)
INTERNAL_API_SECRET=ucust-super-secret-service-token-2026

# HMAC-SHA256 Secret for signing outgoing Webhook callbacks (X-UCust-Signature)
WEBHOOK_HMAC_SECRET=ucust-webhook-hmac-sha256-signing-secret-2026
WEBHOOK_MAX_RETRIES=4                  # Exponential backoff attempts (1s, 2s, 4s, 8s)

# ------------------------------------------------------------------------------
# 3. DATABASE & VECTOR STORAGE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
UCUST_DB_HOST=postgres
UCUST_DB_PORT=5432
POSTGRES_DB=ucust_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ucust_secure_postgres_pass_2026
DATABASE_URL=postgresql+asyncpg://postgres:ucust_secure_postgres_pass_2026@postgres:5432/ucust_ai

# Fallback for local non-docker debug: sqlite+aiosqlite:///./ai_smm_dev.db

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED MESSAGE BROKER & TASK BUS (Redis + Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Queues
CELERY_CPU_QUEUE=ucust_ai_queue
CELERY_GPU_QUEUE=ucust_gpu_render

# ------------------------------------------------------------------------------
# 5. COMFYUI GPU RENDER BRIDGE
# ------------------------------------------------------------------------------
COMFYUI_HOST=127.0.0.1                  # or host.docker.internal / comfyui_service
COMFYUI_PORT=8188
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_OUTPUT_DIR=/app/output/photos

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (S3 / MinIO / Local Static)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                 # local | s3 | minio
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=ucust-media-prod
S3_REGION_NAME=eu-central-1
STATIC_MEDIA_BASE_URL=http://localhost:8000/output/photos

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY, MONITORING & TELEMETRY
# ------------------------------------------------------------------------------
# Sentry Error Tracking & Performance Profiling
SENTRY_DSN=                            # https://your-sentry-dsn@sentry.io/123456
SENTRY_TRACES_SAMPLE_RATE=0.2          # 20% performance trace sampling
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus Metrics Exporter
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=8000           # Exposes /metrics endpoint on FastAPI

# ------------------------------------------------------------------------------
# 8. EXTERNAL BACKEND INTEGRATION & WEBHOOKS
# ------------------------------------------------------------------------------
BACKEND_COLLECTOR_CALLBACK_URL=http://host.docker.internal:8080/api/v1/ai/callback
JAVA_BACKEND_CALLBACK_URL=http://host.docker.internal:8080/api/v1/ai/callback
