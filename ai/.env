# Single-Server Deployment Environment Configuration for UCust.AI

# Database Settings (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_smm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
UCUST_DB_HOST=localhost
UCUST_DB_PORT=5432

# RabbitMQ Message Broker (AMQP 0-9-1)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_AI_TASK_QUEUE=ai_task_queue
RABBITMQ_AI_RESULT_QUEUE=ai_result_queue
RABBITMQ_AI_EVENTS_EXCHANGE=ai_events_exchange

# Media Storage Retention (TTL: 30 days)
MEDIA_RETENTION_DAYS=30
MEDIA_AUTO_ARCHIVE=true

# Application Settings
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
UCUST_LOG_LEVEL=INFO
UCUST_APP_TITLE="UCust.AI API"
UCUST_APP_VERSION="2.1.0-SingleServer"

# ComfyUI Integration (Single-Server)
COMFYUI_SERVER_ADDRESS=host.docker.internal:8188
COMFYUI_OUTPUT_DIR=/app/output
HOST_COMFYUI_OUTPUT_DIR=./output

# Travity Web Search API Key
TRAVITY_API_KEY=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

# ---------------------------------------------------------
# Telegram Parser (Telethon)
# Получить на: https://my.telegram.org/apps
# ---------------------------------------------------------
TELETHON_API_ID=37805806
TELETHON_API_HASH=3edb95f2db1a5bf4d67608d79db10bbf
TELETHON_SESSION=ucust_session
UCUST_TELETHON_CHANNEL=@testaipublisher

# Telegram Bot API Token (HTTPS)
TELEGRAM_BOT_TOKEN=8840988455:AAFsUPjrOSvQdMpuK5c-MkQdPcVB092tPzw
UCUST_ACHIEVEMENT_CHANNEL=@testaipublisher

# Telegram Proxy Settings (SOCKS5 / HTTP / MTProto)
# Вариант 1 (полная строка): socks5://user:password@ip:port или http://ip:port
TELETHON_PROXY_URL=
# Вариант 2 (раздельные параметры):
TELETHON_PROXY_TYPE=socks5
TELETHON_PROXY_HOST=
TELETHON_PROXY_PORT=
TELETHON_PROXY_USER=
TELETHON_PROXY_PASSWORD=

# ---------------------------------------------------------
# VK Parser (vk_api)
# Получить на: https://dev.vk.com -> Мои приложения -> Access Token
# ---------------------------------------------------------
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
UCUST_VK_GROUP_ID=

# ---------------------------------------------------------
# Odnoklassniki (OK API)
# ---------------------------------------------------------
OK_APPLICATION_ID=
OK_PUBLIC_KEY=
OK_SECRET_KEY=
OK_ACCESS_TOKEN=

# ---------------------------------------------------------
# Instagram Graph API
# ---------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---------------------------------------------------------
# Yandex Maps / Yandex Business
# ---------------------------------------------------------
YANDEX_MAPS_API_KEY=
YANDEX_BUSINESS_OAUTH_TOKEN=

# ---------------------------------------------------------
# 2GIS (2ГИС) API
# ---------------------------------------------------------
TWOGIS_API_KEY=

# ---------------------------------------------------------
# Server Performance Mode
# ---------------------------------------------------------
SERVER_MODE=true
