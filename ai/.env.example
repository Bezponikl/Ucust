# =====================================================================
# UCust AI & Data Service Configuration (.env)
# =====================================================================

# 1. СЕТЕВЫЕ НАСТРОЙКИ AI ШЛЮЗА (FastAPI)
# ---------------------------------------------------------------------
# 0.0.0.0 позволяет принимать запросы с других серверов и Docker-контейнеров
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# 2. ПОДКЛЮЧЕНИЕ К COMFYUI ДЛЯ ГЕНЕРАЦИИ И РЕДАКТИРОВАНИЯ ФОТО
# ---------------------------------------------------------------------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_URL=http://127.0.0.1:8188

# 3. БАЗЫ ДАННЫХ И ХРАНИЛИЩЕ (PostgreSQL + pgvector / Redis)
# ---------------------------------------------------------------------
# Вариант 1 (PostgreSQL с расширением pgvector):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_smm
# Вариант 2 (Локальный SQLite для разработки):
# DATABASE_URL=sqlite:///./ai_smm_dev.db

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_smm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://localhost:6379/0

# 4. УПРАВЛЕНИЕ ХРАНЕНИЕМ МЕДИАФАЙЛОВ (Очистка и архивация)
# ---------------------------------------------------------------------
# Хранение сгенерированных фото и видео (в днях)
MEDIA_RETENTION_DAYS=30
# Хранение временного кэша парсинга страниц и соцсетей (в часах)
TEMP_CACHE_RETENTION_HOURS=5
MEDIA_AUTO_ARCHIVE=true

# 4. БРОКЕР СООБЩЕНИЙ RABBITMQ (Взаимодействие с Java Backend)
# ---------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Имена очередей задач и результатов
RABBITMQ_AI_TASK_QUEUE=ai_task_queue
RABBITMQ_AI_RESULT_QUEUE=ai_result_queue
RABBITMQ_AI_EVENTS_EXCHANGE=ai_events_exchange

# 4. СОЦИАЛЬНЫЕ СЕТИ И ПУБЛИКАЦИИ UCUST
# ---------------------------------------------------------------------
UCUST_TELEGRAM_LINK=https://t.me/UcustAi
UCUST_MAX_LINK=https://max.ru/channel_UCust
UCUST_VK_LINK=https://vk.ru/ucustai

# Токены для авто-публикаций (при необходимости)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHANNEL=@UcustAi
MAX_API_TOKEN=
MAX_CHAT_ID=channel_UCust
UCUST_VK_ACCESS_TOKEN=
UCUST_VK_GROUP_ID=ucustai
